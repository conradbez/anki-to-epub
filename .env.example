# Copy to .env and fill in. NEVER commit real credentials.

# --- AnkiWeb account (sync job) ---
ANKI_USERNAME=you@example.com
ANKI_PASSWORD=your-ankiweb-password

# --- Delivery (sync job -> OPDS server) ---
# The upload endpoint of your deployed server and the account capability token
# (create one with: python -m server.admin add <owner>).
OPDS_UPLOAD_URL=https://your-app.up.railway.app/upload
OPDS_TOKEN=CHANGEME16CHARSXX

# --- Optional ---
ANKI_BOOK_TITLE=My Anki Decks
# Read from a local .colpkg instead of hitting AnkiWeb (offline / manual export):
# ANKI_COLPKG_PATH=/path/to/collection.colpkg

# --- OPDS server ---
DATA_DIR=./data
SECRET_KEY=generate-a-long-random-string
ALLOWED_HOSTS=*
# Optional: require this code to create an account via the web signup page.
# Leave unset for open signup (fine for a private household instance).
# SIGNUP_CODE=our-household-2024
